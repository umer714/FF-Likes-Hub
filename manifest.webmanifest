{
  "name": "Mindora — Learn Smarter. Go Further.",
  "short_name": "Mindora",
  "description": "A premium AI-powered study space for notes, quizzes, flashcards, PDF study help, and focused learning.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#070a14",
